<?xml version="1.0" encoding="utf-8"?>
<!-- One agent card in the Agent Dashboard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_ai_settings_card"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Icon + name + description + install badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/agent_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_agent_icon"
            android:gravity="center"
            android:text="🟠"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/agent_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Claude Code"
                    android:textColor="@color/zc_text_white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/agent_default_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_status_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="DEFAULT"
                    android:textColor="@color/zc_badge_installed_text"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/agent_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Agentic coding CLI"
                android:textColor="@color/zc_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/agent_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_installed"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="READY"
            android:textColor="@color/zc_badge_installed_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_agent_gui_command"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Command"
            android:textColor="@color/zc_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_agent_toggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Disable"
            android:textColor="@color/zc_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_agent_install"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_red_button"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Install"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_agent_login"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_fab_dark"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Login"
            android:textColor="@color/zc_text_white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_agent_default"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_fab_dark"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Use in Chat"
            android:textColor="@color/zc_text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/agent_command_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/zc_text_muted"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
