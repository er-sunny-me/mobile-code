<?xml version="1.0" encoding="utf-8"?>
<!-- One coding agent row in the setup wizard picker. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_ai_settings_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <CheckBox
        android:id="@+id/agent_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/zc_red_primary" />

    <TextView
        android:id="@+id/agent_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_agent_icon"
        android:gravity="center"
        android:text="🟠"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/agent_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Claude Code"
            android:textColor="@color/zc_text_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agent_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="download"
            android:textColor="@color/zc_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/agent_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text=""
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
