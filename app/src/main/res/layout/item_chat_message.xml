<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_message_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Assistant Icon (shown for agent, hidden for user) -->
    <TextView
        android:id="@+id/message_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:text="🟠"
        android:textSize="18sp"
        android:background="@drawable/bg_agent_icon"
        android:layout_marginEnd="12dp" />

    <!-- Message Bubble -->
    <LinearLayout
        android:id="@+id/message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="#2E2E3A"
        android:padding="12dp"
        android:orientation="vertical">
        
        <TextView
            android:id="@+id/message_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </LinearLayout>
    
    <!-- User Spacer (to push user messages to right, handled in code) -->
    <Space
        android:id="@+id/message_spacer"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
