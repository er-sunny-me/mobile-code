<?xml version="1.0" encoding="utf-8"?>
<!-- Agent Dashboard: install / configure / choose CLI coding agents. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_agent_dashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zc_chat_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/zc_bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btn_dash_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/zc_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Coding Agents"
            android:textColor="@color/zc_text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_dash_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Re-check installed agents"
            android:src="@drawable/ic_refresh"
            app:tint="@color/zc_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/zc_border" />

    <TextView
        android:id="@+id/tv_dash_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zc_bg_dark"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="Agents are installed into the Termux environment. Tap Install to download one, then use it from the Agent Chat screen."
        android:textColor="@color/zc_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/btn_dash_setup_all"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_red_button"
        android:gravity="center"
        android:text="Setup Ubuntu + Install all agents"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_agents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="24dp" />

</LinearLayout>
