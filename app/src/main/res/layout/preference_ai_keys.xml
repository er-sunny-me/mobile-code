<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CLI Agent Backend"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select the CLI coding agent that will run in the terminal when you use the Chat UI."
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Spinner
        android:id="@+id/spinner_ai_provider"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/editTextBackground"
        android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/anthropic_settings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Anthropic / AgentRouter Settings"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_anthropic_auth_token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Auth Token (e.g. sk-ant-api...)"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_anthropic_base_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Base URL (e.g. https://agentrouter.org)"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/et_anthropic_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Model (e.g. claude-opus-4-6)"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/custom_command_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Custom Command"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />
            
        <EditText
            android:id="@+id/et_custom_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. claude --dangerously-skip-permissions"
            android:fontFamily="monospace"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
