<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_git_workspace"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone"
    android:background="#1E1E1E">

    <!-- Commit Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#252526">

        <EditText
            android:id="@+id/et_git_commit_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:hint="Message (Commit &amp; Push)"
            android:textColorHint="#808080"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:background="@null"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <Button
            android:id="@+id/btn_git_commit"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:text="Commit &amp; Push"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:backgroundTint="@color/zc_bg_dark" />

    </LinearLayout>

    <!-- Header for Changes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#1E1E1E">

        <TextView
            android:id="@+id/tv_git_changes_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CHANGES"
            android:textColor="#A0A0A0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_git_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_refresh"
            app:tint="#A0A0A0" />
    </LinearLayout>

    <!-- Changed Files List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_git_files"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
