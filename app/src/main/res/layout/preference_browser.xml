<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D0D10"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="10dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#16161B"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#2A2A32"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Hybrid Browser (Playwright + WebView)"
                android:textColor="#F3F4F6"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Playwright handles headless Chromium automation for AI agents, while WebView lets you browse &amp; preview inside Xyz.IDE."
                android:textColor="#9CA3AF"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_settings_row"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Playwright (Ubuntu PRoot AI)"
                        android:textColor="#F3F4F6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_playwright_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_missing"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="Not set"
                        android:textColor="#FBBF24"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_playwright_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Checking Ubuntu Playwright + Chromium..."
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_install_playwright"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Install Playwright"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="#007ACC"
                        app:cornerRadius="8dp" />

                    <Button
                        android:id="@+id/btn_open_webview_browser"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Open WebView"
                        android:textAllCaps="false"
                        android:textColor="#E5E7EB"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="#282830"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
