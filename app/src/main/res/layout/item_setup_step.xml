<?xml version="1.0" encoding="utf-8"?>
<!-- One step row in the first-run setup wizard. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_ai_settings_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/setup_step_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_agent_icon"
        android:gravity="center"
        android:text="○"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/setup_step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Step"
            android:textColor="@color/zc_text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setup_step_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/zc_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/setup_step_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="QUEUED"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
